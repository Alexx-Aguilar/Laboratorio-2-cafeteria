# Puerto de la API
PORT=3001

# Motor de base de datos ('sqlite' o 'postgres')
# Por defecto utiliza 'sqlite' embebido para no requerir instalación externa.
# Para conectar a PostgreSQL real, cambiar a DB_CLIENT=postgres y configurar credenciales.
DB_CLIENT=sqlite
SQLITE_PATH=./cafeteria.sqlite

# Configuración PostgreSQL (si DB_CLIENT=postgres)
PGHOST=localhost
PGPORT=5432
PGDATABASE=cafeteria_db
PGUSER=postgres
PGPASSWORD=postgres

# URL Webhook opcional de n8n (para el AI Agent)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/sugerencia-compras
